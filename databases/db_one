-- Connect as postgres
CREATE DATABASE ancestry_mvp;
\c ancestry_mvp

-- Enable extensions
CREATE EXTENSION "uuid-ossp";
CREATE EXTENSION vector;

-- Core person table (replaces graph vertex)
CREATE TABLE persons (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    user_id UUID NOT NULL,  -- Who owns this person
    
    -- Basic info
    name VARCHAR(255) NOT NULL,
    native_name VARCHAR(255),
    birth_date DATE,
    death_date DATE,
    gender VARCHAR(10) CHECK (gender IN ('male', 'female', 'other', 'unknown')),
    
    -- African cultural context
    tribe VARCHAR(50),
    clan VARCHAR(100),
    village_origin VARCHAR(100),
    town VARCHAR(100),
    state VARCHAR(100),
    country VARCHAR(100) DEFAULT 'Nigeria',
    
    -- Arrays for multiple values
    occupation TEXT[],
    titles TEXT[],
    languages TEXT[],
    
    -- Biography and AI embedding
    biography TEXT,
    embedding VECTOR(768),  -- For Afro-XLMR embeddings
    
    -- Metadata
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    
    -- Constraints
    CONSTRAINT valid_dates CHECK (death_date IS NULL OR death_date >= birth_date)
);

-- Relationships table (replaces graph edges)
CREATE TABLE relationships (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    from_person_id UUID REFERENCES persons(id) ON DELETE CASCADE,
    to_person_id UUID REFERENCES persons(id) ON DELETE CASCADE,
    
    relationship_type VARCHAR(50) NOT NULL,
    -- Types: PARENT_OF, MOTHER_OF, FATHER_OF, SPOUSE_OF, CO_WIFE_OF, 
    --        SIBLING_OF, HALF_SIBLING_OF, STEP_PARENT_OF, etc.
    
    start_date DATE,
    end_date DATE,
    is_traditional BOOLEAN DEFAULT false,
    notes TEXT,
    
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    
    -- Prevent duplicate relationships
    UNIQUE(from_person_id, to_person_id, relationship_type),
    -- Prevent self-relationships
    CONSTRAINT no_self_rel CHECK (from_person_id != to_person_id)
);

-- Events table (for life events)
CREATE TABLE events (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    person_id UUID REFERENCES persons(id) ON DELETE CASCADE,
    
    event_type VARCHAR(50) NOT NULL,
    -- BIRTH, DEATH, MARRIAGE, NAMING_CEREMONY, TRADITIONAL_FESTIVAL, etc.
    
    event_date DATE,
    location VARCHAR(255),
    description TEXT,
    cultural_significance TEXT,
    
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Migrations table (movement/relocation history, pulled from narrative)
CREATE TABLE migrations (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    person_id UUID REFERENCES persons(id) ON DELETE CASCADE,

    from_place VARCHAR(255),
    to_place VARCHAR(255),
    approx_date VARCHAR(20),   -- deliberately loose: "1960s", "1958", "circa 1900"
    notes TEXT,
    sequence_order INTEGER,    -- lets the migration-map endpoint render an ordered path per person

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Audit log (track all changes)
CREATE TABLE audit_logs (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    user_id UUID,
    action VARCHAR(50),  -- CREATE, UPDATE, DELETE
    entity_type VARCHAR(50),  -- person, relationship, event
    entity_id UUID,
    old_data JSONB,
    new_data JSONB,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Indexes for performance
CREATE INDEX idx_persons_user ON persons(user_id);
CREATE INDEX idx_persons_embedding ON persons USING ivfflat (embedding vector_cosine_ops);
CREATE INDEX idx_relationships_from ON relationships(from_person_id);
CREATE INDEX idx_relationships_to ON relationships(to_person_id);
CREATE INDEX idx_events_person ON events(person_id);
CREATE INDEX idx_migrations_person ON migrations(person_id);

-- Full-text search on names
CREATE INDEX idx_persons_name_trgm ON persons USING gin (name gin_trgm_ops);